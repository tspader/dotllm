{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["bun"],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "esModuleInterop": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "baseUrl": ".",
    "paths": {
      "dotllm/cli": ["src/cli/index.ts"],
      "dotllm/cli/*": ["src/cli/*"],
      "dotllm/core": ["src/core/index.ts"],
      "dotllm/core/*": ["src/core/*"]
    }
  },
  "include": ["src/**/*.ts"]
}
